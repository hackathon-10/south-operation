# ============================================================
# דרומה - קובץ דוגמה למשתני סביבה
# NoCyberHere: SECRET_MANAGEMENT
# Threat: חשיפת סודות דרך קוד המקור
# Reason: כל הסודות מגיעים מסביבת ההרצה בלבד. אין למלא כאן ערכים אמיתיים.
# ============================================================

# --- Supabase / PostgreSQL -----------------------------------
# DATABASE_URL: חיבור דרך ה-Connection Pooler של Supabase (פורט 6543) - מתאים ל-Serverless.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: חיבור ישיר (פורט 5432) - נדרש להרצת migrations בלבד.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Supabase project (אופציונלי, לשימוש עתידי בצד שרת בלבד) ---
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# לעולם לא נחשף ל-Frontend ואין לו prefix ציבורי.
SUPABASE_SERVICE_ROLE_KEY=""

# --- JWT ------------------------------------------------------
# יש לייצר מחרוזות אקראיות באורך 32 תווים לפחות, לדוגמה: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- API ------------------------------------------------------
NODE_ENV="development"
PORT="3000"
# רשימת Origins מורשים ל-CORS, מופרדים בפסיק.
CORS_ORIGINS="http://localhost:5173"
# מאפשר את מסך בחירת משתמש דמו ואת נתיב /auth/demo-users. אסור להפעיל בפרודקשן.
ENABLE_DEMO_LOGIN="true"
# כתובת ה-Frontend, משמשת לבניית ה-URL שבתוך ה-QR.
# בפריסה: חייבת להיות הכתובת היציבה של ה-Frontend (לא כתובת Deployment חד-פעמית),
# אחרת קודי QR שיודפסו יצביעו לגרסה ישנה וקפואה. ראו README.
WEB_APP_URL="http://localhost:5173"
# סיסמת משתמשי הדמו שנוצרים ב-seed. אם ריק, ה-seed מייצר סיסמה אקראית ומדפיס אותה פעם אחת.
SEED_DEMO_PASSWORD=""

# --- Frontend (apps/web) --------------------------------------
# משתנים עם prefix VITE_ נחשפים לדפדפן. אין להכניס כאן סודות.
VITE_API_BASE_URL="http://localhost:3000/api/v1"
