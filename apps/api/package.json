{
  "name": "@south/api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS API של מערכת דרומה",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src prisma --max-warnings=0",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "create:operation-manager": "ts-node --transpile-only prisma/create-operation-manager.ts",
    "import:mapping": "ts-node --transpile-only prisma/import-mapping.ts",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:e2e": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.e2e.config.js --runInBand",
    "e2e:server": "node --experimental-vm-modules -r ts-node/register/transpile-only test/e2e-server.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.0",
    "@node-rs/argon2": "2.2.1",
    "@prisma/client": "6.19.3",
    "@south/shared": "1.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.2",
    "dotenv": "18.0.3",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/testing": "11.2.5",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "pglite-prisma-adapter": "^0.6.1",
    "prisma": "6.19.3",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.6.3"
  }
}
