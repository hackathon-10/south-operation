{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "baseUrl": ".",
    "types": ["node", "jest"],
    "strictPropertyInitialization": false,
    "noImplicitAny": true
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "test/**/*.ts", "api/**/*.ts"]
}
